#!/usr/bin/env bash

echo "Bienvenue dans le système de vote."
while true; do
    read -ep "saisir une commande : " cmd args
    case "$cmd" in
        newvote)
            # crée un nouveau vote
            ./newvote.sh
            ;;
        catvote)
            # affiche le contenu d'un vote en donnant son numéro
            nb_args=$(echo "$args" | wc -w)
            if [ -z "$args" ]
            then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 2 ]
            then
                echo "veuillez choisir un seul vote"
            else
                ./catvote.sh "$args"
            fi
            ;;
        rmvote)
            #supprime un vote deja créé en donnant son numéro et auteur
            nb_args=$(echo "$args" | wc -w)
            if [[ -z "$args" || ! ("$args" =~ ^[0-9[:space:]]+$) ]]
            then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 2 ]
            then
                echo "veuillez choisir un seul vote"
            else
                ./rmvote.sh "$args"
            fi
            ;;
        editvote)
            #modifie un vote deja cree
            ;;
        repvote)
            #repond a un vote bonjooooour encoooooore
            ;;
        lsvote)
            #affiche les votes crée par un utilisateurs donné
            ./lsvote.sh "$args" 
            ;;
        quit|exit)
            echo "Au revoir !"
            break
            ;;
        *)
            echo "Commande inconnue : $cmd"
            ;;
    esac
done
