#!/usr/bin/env bash

echo "Bienvenue dans le système de vote."
while true; do
    read -ep "saisir une commande : " cmd args
    case "$cmd" in
        newvote)
            # crée un nouveau vote
            ./newvote.sh
            ;;
        catvote)
            # affiche le contenu d'un vote en donnant son numéro
            nb_args=$(echo "$args" | wc -w)
            if [[ -z "$args" || ! ("$args" =~ ^[0-9[:space:]]+$) ]]; then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 2 ]; then
                echo "veuillez choisir un seul vote"
            else
                ./catvote.sh "$args"
            fi
            ;;
        rmvote|editvote)
            # supprime un vote deja créé en donnant son numéro et auteur
            # modifie un vote deja créé
            nb_args=$(echo "$args" | wc -w)
            if [[ -z "$args" || ! ("$args" =~ ^[0-9[:space:]]+$) ]]; then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 2 ]; then
                echo "veuillez choisir un seul vote"
            elif [ "$cmd" == rmvote ]; then
                ./rmvote.sh "$args"
            elif [ "$cmd" == editvote ]; then
                ./editvote.sh "$args"
            fi
            ;;
        closevote)
            # ferme un vote avant la date de fin
            nb_args=$(echo "$args" | wc -w)
            if [[ -z "$args" || ! ("$args" =~ ^[0-9[:space:]]+$) ]]; then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 2 ]; then
                echo "veuillez choisir un seul vote"
            else
                ./closevote.sh "$args"
            fi
            ;;
        repvote)
            # répond a un vote
            nb_args=$(echo "$args" | wc -w)
            if [[ -z "$args" || ! ("$args" =~ ^[-0-9m[:space:]]+$) ]]; then
                echo "veuillez choisir un numéro de vote"
            elif [ "$nb_args" -ge 3 ]; then
                echo "veuillez choisir un seul vote"
            else
                ./repvote.sh "$args"
            fi
            ;;
        lsvote)
            # affiche les votes créés par un utilisateur donné
            ./lsvote.sh "$args" 
            ;;
        sysvote)
            # génère un document pdf de statistiques du système de vote depuis son lancement
            ./sysvote.sh
            ;;
        quit|exit)
            echo "Au revoir !"
            break
            ;;
        *)
            echo "Commande inconnue : $cmd"
            ;;
    esac
done
